{
  "appId": "app.miniport.faridabad",
  "appName": "MiniPort",
  "webDir": "dist/client",
  "loggingBehavior": "production",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Geolocation": {
      "enableLocationFallback": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_miniport",
      "iconColor": "#F97316",
      "presentationOptions": ["badge", "sound", "banner", "list"]
    }
  }
}
