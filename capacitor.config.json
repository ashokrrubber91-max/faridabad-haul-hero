{
  "appId": "app.miniport.faridabad",
  "appName": "MiniPort",
  "webDir": "dist/client",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Camera": {
      "saveToGallery": false
    }
  }
}
